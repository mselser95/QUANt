    {
      "id": 4,
      "type": "stat",
      "title": "Gas cost of one 2-leg arbitrage",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "arb-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "arb-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT gas_usdc AS value FROM opportunities WHERE n_legs = 2 ORDER BY block_number DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "thresholds": {
