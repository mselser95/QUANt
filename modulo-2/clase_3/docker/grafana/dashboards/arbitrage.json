          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cycle AS \"Cycle\", gap_bps AS \"Gap (bps)\", dx_star_usdc AS \"dx* (USDC)\", gross_usdc AS \"Gross\",\n       flash_fee_usdc AS \"Flash fee\", gas_usdc AS \"Gas\", net_usdc AS \"Net (USDC)\", profitable AS \"Profitable\"\nFROM opportunities WHERE block_number = (SELECT max(block_number) FROM opportunities)\nORDER BY gap_bps DESC LIMIT 12"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
