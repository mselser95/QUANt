    {
      "id": 7,
      "type": "timeseries",
      "title": "Gap per cycle, top 6 (bps)",
      "description": "gamma^n * prod(r_out/r_in) - 1, in bps. Above 0 there is a gross opportunity; fees and gas still have to be paid.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "arb-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "arb-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT block_time AS time, cycle AS metric, gap_bps AS value FROM opportunities\nWHERE $__timeFilter(block_time) AND cycle IN (\n  SELECT cycle FROM opportunities WHERE $__timeFilter(block_time) GROUP BY cycle ORDER BY max(gap_bps) DESC LIMIT 6)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Top cycles of the latest block",
      "datasource": {
        "type": "grafana-postgresql-datasource",
